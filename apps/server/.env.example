# 复制为 .env 后填写。切勿提交 .env。
# DeepSeek（OpenAI 兼容），key 由后端持有，地址可手动填写
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# JWT 签名密钥，至少 16 字符，务必改成随机长串
JWT_SECRET=change-me-to-a-long-random-secret

# SQLite 文件路径
DB_PATH=./data/tianji.sqlite

# 监听端口
PORT=8787

# 会话闲置过期（毫秒），默认 6 小时
SESSION_IDLE_MS=21600000

# auth 限流（内存滑动窗口，按 IP）。默认：登录 10 分钟 10 次、注册每小时 5 次，
# 超出返回 429 rate_limited。阈值/窗口可调，调大即可在开发/压测期放行。
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=600000
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
