# 复制为 .env 后填写。切勿提交 .env。
# DeepSeek（OpenAI 兼容），key 由后端持有，地址可手动填写
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# JWT 签名密钥，至少 16 字符，务必改成随机长串
JWT_SECRET=change-me-to-a-long-random-secret

# SQLite 文件路径
DB_PATH=./data/tianji.sqlite

# 监听端口
PORT=8787

# 会话闲置过期（毫秒），默认 6 小时
SESSION_IDLE_MS=21600000
