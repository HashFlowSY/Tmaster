{
  "expo": {
    "name": "天机",
    "slug": "tianji",
    "scheme": "tianji",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.tianji.app",
      "usesCleartextTraffic": true
    },
    "ios": {
      "bundleIdentifier": "com.tianji.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSerifSC-Regular.ttf",
            "./assets/fonts/NotoSansSC-Regular.ttf",
            "./assets/fonts/NotoSansSC-Medium.ttf",
            "./assets/fonts/NotoSansSC-SemiBold.ttf"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
